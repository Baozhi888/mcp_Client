# 笔记本MCP服务配置文件
# 复制此文件为.env并填入实际配置值
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=eyJhbGciOiJFUzI1NiIsInR...
# ==================== Cloudflare配置 ====================
# Cloudflare API Token (需要KV和D1权限)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare账户ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# KV命名空间ID (用于存储文件内容)
KV_NAMESPACE_ID=your_kv_namespace_id_here

# D1数据库ID (用于存储元数据)
D1_DATABASE_ID=your_d1_database_id_here

# ==================== Gmail配置 ====================
# Gmail API凭证文件路径
GMAIL_API_CREDENTIALS_FILE=.google_key/gmail_credentials.json

# Gmail Token文件路径
TOKEN_PATH=.google_key/token.json

# 服务器模式 (true=服务器环境, false=本地环境)
SERVER_MODE=false

# Gmail API配置
MAX_EMAILS_TO_FETCH=20
RECONNECT_TIMEOUT=120

# OAuth授权码 (服务器模式下使用)
AUTHORIZATION_CODE=

# ==================== 服务配置 ====================
# 启用Gmail集成
ENABLE_GMAIL_INTEGRATION=true

# 最大文件大小 (字节)
MAX_FILE_SIZE=10485760  # 10MB

# 允许的文件类型 (MIME类型，逗号分隔)
ALLOWED_FILE_TYPES=text/plain,text/markdown,application/pdf,image/jpeg,image/png,application/json

# 提醒检查间隔 (秒)
REMINDER_CHECK_INTERVAL=60

# 自动备份笔记
AUTO_BACKUP_NOTES=true

# 智能分类功能
SMART_CATEGORIZATION=true

# ==================== 日志配置 ====================
# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# ==================== 安全配置 ====================
# API访问密钥 (可选，用于API访问控制)
API_SECRET_KEY=your_secret_key_here

# 允许的域名 (可选，用于CORS)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ==================== 功能开关 ====================
# 启用文件上传功能
ENABLE_FILE_UPLOAD=true

# 启用提醒功能
ENABLE_REMINDERS=true

# 启用邮件通知
ENABLE_EMAIL_NOTIFICATIONS=true

# 启用自动标签提取
ENABLE_AUTO_TAGGING=true

# ==================== 性能配置 ====================
# 数据库连接池大小
DB_POOL_SIZE=10

# 请求超时时间 (秒)
REQUEST_TIMEOUT=30

# 缓存过期时间 (秒)
CACHE_EXPIRE_TIME=3600

# ==================== 开发配置 ====================
# 开发模式
DEBUG_MODE=false

# 测试模式
TEST_MODE=false

# 详细日志
VERBOSE_LOGGING=false
