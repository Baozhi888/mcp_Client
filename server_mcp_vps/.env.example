# ============================================
# VPS MCP Server Management 环境配置
# 部署时复制为 .env 并根据服务器修改
# ============================================

# 服务器标识 (每台服务器必须唯一)
SERVER_ID=vps_001
SERVER_NAME=Web Server 1
SERVER_LOCATION=US-West
SERVER_ROLE=production

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 允许管理的服务列表 (逗号分隔)
# 使用 * 允许所有服务 (不推荐生产环境)
ALLOWED_SERVICES=nginx,mysql,redis,docker,ssh,cron

# 资源限制阈值
MAX_CPU_PERCENT=90
MAX_MEMORY_PERCENT=90
MAX_DISK_PERCENT=95
MAX_COMMAND_TIMEOUT=3600

# MCP Gateway 配置 (用于 mcp_pipe.py 连接)
# MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN

# MCP 服务入口 (相对于 mcp_Client 目录)
# MCP_SCRIPTS=server_mcp_vps/server_mcp.py
