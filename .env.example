# Copy to .env and fill real values. Do not commit .env.
# Keep secrets empty here; use real values only in your local .env.

# MCP endpoint and service supervisor
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=
MCP_SCRIPTS="calculator.py notepad_mcp/notepad_mcp_fixed.py xiaozhi-websearch/websearch_optimized.py server_mcp_vps/server_mcp.py"
MCP_INSTALL_DEPS_ON_START=false
MCP_NOTEPAD_EXPORT_MODE=redis
MCP_4004_BACKOFF=60
MCP_WS_OPEN_TIMEOUT=60
MCP_WS_PING_INTERVAL=30
MCP_WS_PING_TIMEOUT=180
MCP_HEAVY_SERVICES=aktools
MCP_HEAVY_SERVICE_DELAY=5

# Redis
MCP_REDIS_HOST=redis
MCP_REDIS_PORT=6379
MCP_REDIS_DB=1
MCP_REDIS_PASSWORD=change_this_to_a_strong_password
ENABLE_REDIS_LISTENER=true

# Runtime, logging, and network
LOG_LEVEL=INFO
PYTHONUTF8=1
MALLOC_ARENA_MAX=2
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
HTTP_PROXY=
HTTPS_PROXY=

# Gmail
GMAIL_API_CREDENTIALS_FILE=notepad_mcp/.google_key/gmail_credentials.json
TOKEN_PATH=notepad_mcp/.google_key/token.json
SERVER_MODE=true
AUTHORIZATION_CODE=
MAX_EMAILS_TO_FETCH=20
RECONNECT_TIMEOUT=60
GMAIL_API_TIMEOUT=60
GMAIL_SENDER_NAME=小可爱
GMAIL_SENDER_EMAIL=
GMAIL_DUPLICATE_WINDOW_SECONDS=120

# Notepad features
ENABLE_GMAIL_INTEGRATION=true
AUTO_BACKUP_NOTES=true
SMART_CATEGORIZATION=true
ENABLE_AUTO_TAGGING=true
ENABLE_FILE_UPLOAD=true
ENABLE_REMINDERS=true
ENABLE_EMAIL_NOTIFICATIONS=false
REMINDER_CHECK_INTERVAL=60

# Notepad limits, CORS, and security
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,audio/mpeg,audio/wav,video/mp4,video/quicktime
API_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
DB_POOL_SIZE=10
REQUEST_TIMEOUT=30
CACHE_EXPIRE_TIME=3600
DEBUG_MODE=false
TEST_MODE=false
VERBOSE_LOGGING=false
CUSTOM_DOMAIN=

# Notepad image and document processing
DEFAULT_CAMERA_INDEX=0
IMAGE_SAVE_DIR=notepad_mcp/uploads/images
CAMERA_WARMUP_SECONDS=1
DEFAULT_CAPTURE_WIDTH=1280
DEFAULT_CAPTURE_HEIGHT=720
TEST_STRATEGY=standard
PNG_TARGET_WIDTH=1024
PNG_TARGET_HEIGHT=1024
DEFAULT_JPEG_QUALITY=85

# Cloudflare storage backends
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
KV_NAMESPACE_ID=
D1_DATABASE_ID=

# Search, market, and model API keys
GOOGLE_API_KEY=
GOOGLE_CX=
BING_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
NEWS_API_KEY=
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=
TUSHARE_TOKEN=
DASHSCOPE_API_KEY=

# Websearch and market performance tuning
WEBSEARCH_MAX_MEMORY=512
WEBSEARCH_TIMEOUT=30
WEBSEARCH_CACHE_TTL=3600
WEBSEARCH_CACHE_MAX_MB=32
WEBSEARCH_MAX_CONTENT_MB=5
WEBSEARCH_TOTAL_TIMEOUT_S=20
LLM_CACHE_TTL=3600
AKTOOLS_REQUEST_TIMEOUT=60
