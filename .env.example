# Copy to .env and fill real values. Do not commit .env.

MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=
MCP_SCRIPTS="calculator.py notepad_mcp/notepad_mcp_fixed.py xiaozhi-websearch/websearch_optimized.py server_mcp_vps/server_mcp.py"
MCP_REDIS_PASSWORD=change_this_to_a_strong_password
ENABLE_REDIS_LISTENER=true
MCP_INSTALL_DEPS_ON_START=false
LOG_LEVEL=INFO
PYTHONUTF8=1

# Notepad storage backends
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
KV_NAMESPACE_ID=
D1_DATABASE_ID=

# Gmail
GMAIL_API_CREDENTIALS_FILE=notepad_mcp/.google_key/gmail_credentials.json
TOKEN_PATH=notepad_mcp/.google_key/token.json
SERVER_MODE=true
MAX_EMAILS_TO_FETCH=20
RECONNECT_TIMEOUT=60
GMAIL_SENDER_NAME=小可爱
GMAIL_DUPLICATE_WINDOW_SECONDS=120

# Reminder scheduler
REMINDER_CHECK_INTERVAL=60

# Web search
GOOGLE_API_KEY=
GOOGLE_CX=
BING_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
NEWS_API_KEY=
ZHIPU_API_KEY=

# Performance tuning
WEBSEARCH_CACHE_MAX_MB=32
WEBSEARCH_MAX_CONTENT_MB=5
WEBSEARCH_TOTAL_TIMEOUT_S=20
MALLOC_ARENA_MAX=2
